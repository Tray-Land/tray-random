<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayRandom.Views.DrawHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TrayRandom.ViewModels"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid Padding="16,12,12,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="BackButton"
                x:Uid="ListDrawBack"
                AutomationProperties.AutomationId="ListDrawBack"
                Click="Back_Click"
                Style="{StaticResource FlyoutIconButtonStyle}">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                x:Name="PageTitle"
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="True" />

        <Button
            x:Name="RetryButton"
            x:Uid="ListDrawRetry"
            AutomationProperties.AutomationId="ListDrawRetry"
            Grid.Row="2"
            VerticalAlignment="Top"
            Click="Retry_Click"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="LoadingText"
            x:Uid="ListDrawLoadingHistory"
            Grid.Row="2"
            Margin="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <Border
            x:Name="HistoryCard"
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid>
                <ListView
                    x:Name="HistoryList"
                    x:Uid="ListDrawHistoryList"
                    AutomationProperties.AutomationId="ListDrawHistoryList"
                    IsItemClickEnabled="True"
                    ItemClick="HistoryList_ItemClick"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DrawHistoryItem">
                            <StackPanel Margin="0,6">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Details}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    x:Name="EmptyHistoryText"
                    x:Uid="ListDrawEmptyHistory"
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <Border
            x:Name="ResultCard"
            Grid.Row="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <ScrollViewer Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ResultTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ResultDetails"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ResultText"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel
            x:Name="ResultActions"
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <DropDownButton
                x:Name="DeleteRunButton"
                x:Uid="ListDrawDeleteRun"
                AutomationProperties.AutomationId="ListDrawDeleteRun">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Uid="ListDrawConfirmDeleteRun" Click="DeleteRun_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                x:Name="CopyButton"
                x:Uid="ListDrawCopy"
                AutomationProperties.AutomationId="ListDrawCopy"
                Click="Copy_Click">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Control,Shift" />
                </Button.KeyboardAccelerators>
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
            </Button>
        </StackPanel>
    </Grid>
</Page>
