<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayRandom.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrayRandom.Views"
    Background="Transparent"
    KeyboardAcceleratorPlacementMode="Hidden">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F5" Invoked="GenerateAccelerator_Invoked" />
        <KeyboardAccelerator
            Key="R"
            Invoked="GenerateAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Enter"
            Invoked="GenerateAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="D"
            Invoked="FavoriteAccelerator_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Tab"
            Invoked="NextFavorite_Invoked"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Tab"
            Invoked="PreviousFavorite_Invoked"
            Modifiers="Control,Shift" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <Style
            x:Key="FavoriteChipStyle"
            BasedOn="{StaticResource DefaultListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0,12,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Page.Resources>

    <Grid Padding="16,12,12,16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tray Random" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <!--  Favorites: click to switch, drag to reorder, right-click for more  -->
        <Grid Grid.Row="1">
            <ListView
                x:Name="FavoritesView"
                AllowDrop="True"
                AutomationProperties.Name="Favorite categories"
                CanDragItems="True"
                CanReorderItems="True"
                DragItemsCompleted="FavoritesView_DragItemsCompleted"
                IsItemClickEnabled="True"
                ItemClick="FavoritesView_ItemClick"
                ItemContainerStyle="{StaticResource FavoriteChipStyle}"
                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                ScrollViewer.HorizontalScrollMode="Enabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectionMode="Single">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FavoriteChip">
                        <StackPanel
                            AutomationProperties.Name="{x:Bind Name}"
                            Background="Transparent"
                            ContextRequested="FavoriteChip_ContextRequested"
                            Orientation="Horizontal"
                            Spacing="6"
                            ToolTipService.ToolTip="{x:Bind ToolTip}">
                            <FontIcon
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind Glyph}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                x:Name="NoFavoritesText"
                Margin="2,6"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Star a category to pin it here."
                Visibility="Collapsed" />
        </Grid>

        <!--  Category picker and favorite toggle  -->
        <Grid Grid.Row="2" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DropDownButton
                x:Name="CategoryButton"
                Padding="10,6,8,6"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                AutomationProperties.Name="Category">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon
                        x:Name="CategoryGlyph"
                        FontSize="16"
                        Glyph="&#xE8B1;" />
                    <StackPanel>
                        <TextBlock x:Name="CategoryNameText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Name="CategoryGroupText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>
                <DropDownButton.Flyout>
                    <MenuFlyout x:Name="CategoryMenu" Placement="BottomEdgeAlignedLeft" />
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button
                x:Name="FavoriteButton"
                Grid.Column="1"
                Width="44"
                VerticalAlignment="Stretch"
                Click="FavoriteButton_Click">
                <FontIcon x:Name="FavoriteGlyph" FontSize="16" />
            </Button>
        </Grid>

        <!--  Problems with the input; the last results stay visible underneath  -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="False"
            Severity="Warning" />

        <!--  Inputs for the categories that take them  -->
        <StackPanel
            x:Name="DicePanel"
            Grid.Row="4"
            Spacing="8"
            Visibility="Collapsed">
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="DicePreset_Click"
                    Content="d4"
                    Tag="4" />
                <Button
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="DicePreset_Click"
                    Content="d6"
                    Tag="6" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Click="DicePreset_Click"
                    Content="d8"
                    Tag="8" />
                <Button
                    Grid.Column="3"
                    HorizontalAlignment="Stretch"
                    Click="DicePreset_Click"
                    Content="d10"
                    Tag="10" />
                <Button
                    Grid.Column="4"
                    HorizontalAlignment="Stretch"
                    Click="DicePreset_Click"
                    Content="d12"
                    Tag="12" />
                <Button
                    Grid.Column="5"
                    HorizontalAlignment="Stretch"
                    Click="DicePreset_Click"
                    Content="d20"
                    Tag="20" />
                <Button
                    Grid.Column="6"
                    Padding="0,5"
                    HorizontalAlignment="Stretch"
                    Click="DicePreset_Click"
                    Content="d100"
                    Tag="100" />
            </Grid>
            <TextBox
                x:Name="DiceBox"
                AutomationProperties.Name="Dice"
                KeyDown="InputBox_KeyDown"
                PlaceholderText="2d6+3, 4d6kh3, d%"
                ToolTipService.ToolTip="Dice notation: NdS, + or - terms, kh/kl to keep the highest or lowest" />
        </StackPanel>

        <Grid
            x:Name="RangePanel"
            Grid.Row="4"
            ColumnSpacing="8"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox
                x:Name="MinBox"
                Header="From"
                KeyDown="InputBox_KeyDown"
                SpinButtonPlacementMode="Compact"
                ValidationMode="InvalidInputOverwritten" />
            <NumberBox
                x:Name="MaxBox"
                Grid.Column="1"
                Header="To"
                KeyDown="InputBox_KeyDown"
                SpinButtonPlacementMode="Compact"
                ValidationMode="InvalidInputOverwritten" />
        </Grid>

        <TextBox
            x:Name="ListItemsBox"
            Grid.Row="4"
            Height="96"
            AcceptsReturn="True"
            AutomationProperties.Name="List items"
            MaxLength="4000"
            PlaceholderText="One item per line, or separated by commas"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Results  -->
        <Border
            Grid.Row="5"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <ScrollViewer
                    x:Name="SingleResultPanel"
                    Padding="16"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="6">
                        <TextBlock
                            x:Name="ResultText"
                            HorizontalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.Name="Result"
                            IsTextSelectionEnabled="True"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="DetailText"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <ListView
                    x:Name="ResultsList"
                    Padding="0,4"
                    AutomationProperties.Name="Results"
                    IsItemClickEnabled="True"
                    ItemClick="ResultsList_ItemClick"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ResultRow">
                            <Grid
                                Padding="0,6"
                                AutomationProperties.Name="{x:Bind Value}"
                                ColumnSpacing="8"
                                ToolTipService.ToolTip="Click to copy">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    MinWidth="18"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Number}"
                                    TextAlignment="Right" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Value}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind DetailVisibility}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  Actions  -->
        <Grid Grid.Row="6" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <NumberBox
                x:Name="CountBox"
                Width="104"
                AutomationProperties.Name="How many"
                LargeChange="5"
                Maximum="50"
                Minimum="1"
                SmallChange="1"
                SpinButtonPlacementMode="Inline"
                ToolTipService.ToolTip="How many results"
                ValidationMode="InvalidInputOverwritten"
                ValueChanged="CountBox_ValueChanged" />
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="CopyButton"
                Grid.Column="2"
                Height="32"
                AutomationProperties.Name="Copy"
                Click="CopyButton_Click"
                ToolTipService.ToolTip="Copy (Ctrl+Shift+C)">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="C" Modifiers="Control,Shift" />
                </Button.KeyboardAccelerators>
                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
            </Button>
            <Button
                x:Name="GenerateButton"
                Grid.Column="3"
                MinWidth="96"
                Click="GenerateButton_Click"
                Content="Generate"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Ctrl+R" />
        </Grid>
    </Grid>
</Page>
