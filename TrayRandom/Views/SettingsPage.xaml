<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayRandom.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Grid">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ColumnSpacing" Value="12" />
            <Setter Property="RowSpacing" Value="8" />
        </Style>
    </Page.Resources>

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                x:Name="BackButton"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back (Esc)">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,0,-4,0">
            <StackPanel Padding="0,0,4,0" Spacing="4">
                <TextBlock
                    Margin="0,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Generating" />

                <Grid Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel>
                            <TextBlock Text="Language and region" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Used for names, addresses, phone numbers, and text."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Name="LocaleBox"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Language and region"
                            SelectionChanged="LocaleBox_SelectionChanged" />
                    </StackPanel>
                </Grid>

                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Copy automatically" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Put each new result on the clipboard."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="AutoCopyToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Copy automatically"
                        OffContent=""
                        OnContent=""
                        Toggled="AutoCopyToggle_Toggled" />
                </Grid>

                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Favorites" />
                        <TextBlock
                            x:Name="FavoritesDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="ResetFavoritesButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="ResetFavoritesButton_Click"
                        Content="Reset" />
                </Grid>

                <TextBlock
                    Margin="0,16,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="General" />

                <Grid Style="{StaticResource CardStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock
                            x:Name="StartupDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Keep the tray icon ready after you sign in."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="False"
                        OffContent=""
                        OnContent=""
                        Toggled="StartupToggle_Toggled" />
                </Grid>

                <TextBlock
                    x:Name="VersionText"
                    Margin="0,16,0,0"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
