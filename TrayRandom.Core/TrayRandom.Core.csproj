<Project Sdk="Microsoft.NET.Sdk">
  <!--
    UI-free code shared by the app and its tests: the category catalog (Bogus generators), dice
    notation, and favorites. Nothing here may depend on WinUI or Windows APIs.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TrayRandom</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
  </ItemGroup>
</Project>
